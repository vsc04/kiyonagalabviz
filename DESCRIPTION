    R (>= 4.1.0)
Imports:
    ggplot2 (>= 4.0.0),
    grDevices,
    graphics,
    grid,
    stats,
    systemfonts,
    tools,
    utils
Suggests:
    httr,
    jsonlite,
    png,
    scales,
    svglite,
    testthat (>= 3.1.7),
    withr
